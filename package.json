{
  "name": "chiro-tools",
  "version": "0.1.0",
  "description": "CLI interactive pour préparer des enregistrements .wav au format Vigie-Chiro",
  "type": "module",
  "private": true,
  "scripts": {
    "build:worker": "bun build src/lib/audio/splitWorker.ts --target=bun --format=esm --outfile=src/lib/audio/splitWorker.bundled.mjs",
    "dev": "pnpm build:worker && bun src/index.tsx",
    "dev:watch": "pnpm build:worker && bun --watch src/index.tsx",
    "test": "pnpm build:worker && vitest run",
    "test:coverage": "pnpm build:worker && vitest run --coverage",
    "test:watch": "pnpm build:worker && vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:darwin-arm64": "pnpm build:worker && bun build src/index.tsx --compile --target=bun-darwin-arm64 --outfile=dist/chiro-darwin-arm64",
    "build:linux-x64": "pnpm build:worker && bun build src/index.tsx --compile --target=bun-linux-x64 --outfile=dist/chiro-linux-x64",
    "build": "pnpm build:darwin-arm64 && pnpm build:linux-x64",
    "check": "pnpm build:worker && pnpm lint && pnpm typecheck && pnpm format:check && vitest run",
    "prepare": "husky"
  },
  "keywords": [
    "vigie-chiro",
    "chiroptera",
    "cli",
    "ink",
    "bat-acoustics"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.8",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react-devtools-core": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
